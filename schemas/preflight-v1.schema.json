{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deposium:schema:preflight:v1",
  "title": "Deposium offline stack preflight v1",
  "description": "Read-only inventory, source fingerprints and planned contracts. No execution, corpus scoring, runtime qualification or campaign readiness is represented. Nullable Git metadata keeps unavailable and unborn checkouts visible. Cross-record IDs, source correspondence and coverage totals require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "deposium.preflight/v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "const": "offline_stack_preflight"
    },
    "status": {
      "enum": [
        "ok",
        "attention",
        "invalid"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not_run"
        },
        "cases_scored": {
          "const": 0
        },
        "campaign_ready": {
          "const": false
        }
      },
      "required": [
        "status",
        "cases_scored",
        "campaign_ready"
      ]
    },
    "bench": {
      "$ref": "#/$defs/bench"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "deposium.stack-registry/v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "sha256"
      ]
    },
    "stack": {
      "$ref": "#/$defs/stack"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "all",
            "explicit"
          ]
        },
        "selected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "selected_ids"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 0
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external_dependency"
      },
      "minItems": 0
    },
    "runtime_provenance": {
      "$ref": "#/$defs/runtime_provenance"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "purpose",
    "status",
    "evaluation",
    "bench",
    "registry",
    "stack",
    "selection",
    "components",
    "external_dependencies",
    "runtime_provenance",
    "coverage",
    "issues",
    "limitations"
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
    "source_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "present",
            "missing",
            "unsafe_path",
            "excluded",
            "too_large",
            "changed_during_read",
            "unreadable",
            "not_selected",
            "unavailable"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "status",
        "sha256"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "present"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "git_status_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "staged": {
          "type": "integer",
          "minimum": 0
        },
        "unstaged": {
          "type": "integer",
          "minimum": 0
        },
        "untracked": {
          "type": "integer",
          "minimum": 0
        },
        "conflicted": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "staged",
        "unstaged",
        "untracked",
        "conflicted"
      ]
    },
    "git_parent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "status_counts": {
          "$ref": "#/$defs/git_status_counts"
        },
        "gitmodules_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "head",
        "dirty",
        "status_counts",
        "gitmodules_sha256"
      ]
    },
    "git_submodule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "parent_path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "declared": {
          "type": "boolean"
        },
        "gitlink_head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "gitlink_index": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "initialized",
            "uninitialized",
            "invalid",
            "conflict"
          ]
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_counts": {
          "anyOf": [
            {
              "$ref": "#/$defs/git_status_counts"
            },
            {
              "type": "null"
            }
          ]
        },
        "head_matches_gitlink": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "gitmodules_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0
        },
        "declared_path": {
          "type": "string",
          "minLength": 1
        },
        "gitlink_index_stages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "1": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "2": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "3": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          },
          "required": [],
          "minProperties": 1
        }
      },
      "required": [
        "path",
        "parent_path",
        "name",
        "declared",
        "gitlink_head",
        "gitlink_index",
        "head",
        "state",
        "dirty",
        "status_counts",
        "head_matches_gitlink",
        "gitmodules_sha256",
        "issues"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[:\\\\\\r\\n])(?!.*//)(?!.*\\/$).+$"
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "http",
            "library",
            "bootstrap"
          ]
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        },
        "adapter_status": {
          "type": "string",
          "enum": [
            "planned",
            "available",
            "incompatible"
          ]
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tests": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[:\\\\\\r\\n])(?!.*//)(?!.*\\/$).+$"
          }
        },
        "entrypoint_file": {
          "$ref": "#/$defs/source_fingerprint"
        },
        "test_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_fingerprint"
          },
          "minItems": 0
        },
        "execution_status": {
          "const": "not_run"
        },
        "case_ids": {
          "type": "array",
          "maxItems": 0
        },
        "assertion_status": {
          "const": "planned"
        }
      },
      "required": [
        "id",
        "entrypoint",
        "kind",
        "levels",
        "adapter_status",
        "assertions",
        "tests",
        "entrypoint_file",
        "test_files",
        "execution_status",
        "case_ids",
        "assertion_status"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not_observed"
        },
        "executed": {
          "const": false
        }
      },
      "required": [
        "status",
        "executed"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DOC",
              "FOLLOWUP",
              "PRESENTATION",
              "SOURCES",
              "EVIDENCE",
              "CLAIMS",
              "ROBUSTNESS",
              "CONTEXT",
              "EXTRACTION",
              "PRODUCT"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "registry_status": {
          "enum": [
            "registered",
            "missing",
            "unregistered"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "omission_reason": {
          "enum": [
            null,
            "not_selected"
          ]
        },
        "source_state": {
          "enum": [
            "initialized",
            "uninitialized",
            "invalid",
            "conflict",
            "missing"
          ]
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "root_lockfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_fingerprint"
          },
          "minItems": 0
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "source_archive": {
          "const": "not_captured"
        }
      },
      "required": [
        "id",
        "path",
        "owner",
        "role",
        "packs",
        "notes",
        "registry_status",
        "selected",
        "omission_reason",
        "source_state",
        "contracts",
        "root_lockfiles",
        "runtime",
        "source_archive"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "registry_status": {
                "const": "unregistered"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "type": "null"
              },
              "owner": {
                "type": "null"
              },
              "role": {
                "type": "null"
              },
              "packs": {
                "maxItems": 0
              },
              "contracts": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "packs": {
                "minItems": 1
              },
              "contracts": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selected": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "omission_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "omission_reason": {
                "const": "not_selected"
              }
            }
          }
        }
      ]
    },
    "external_dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "const": "not_observed"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "required_by",
        "status"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registered_components": {
          "type": "integer",
          "minimum": 0
        },
        "discovered_components": {
          "type": "integer",
          "minimum": 0
        },
        "selected_components": {
          "type": "integer",
          "minimum": 0
        },
        "selected_contracts": {
          "type": "integer",
          "minimum": 0
        },
        "source_files_present": {
          "type": "integer",
          "minimum": 0
        },
        "adapters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "planned": {
              "type": "integer",
              "minimum": 0
            },
            "available": {
              "type": "integer",
              "minimum": 0
            },
            "incompatible": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": []
        },
        "cases_defined": {
          "const": 0
        },
        "cases_scored": {
          "const": 0
        }
      },
      "required": [
        "registered_components",
        "discovered_components",
        "selected_components",
        "selected_contracts",
        "source_files_present",
        "adapters",
        "cases_defined",
        "cases_scored"
      ]
    },
    "runtime_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not_observed"
        },
        "compose_file_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_fingerprint"
          },
          "minItems": 0
        },
        "effective_compose_files": {
          "type": "null"
        },
        "images": {
          "type": "null"
        },
        "build_sources": {
          "type": "null"
        },
        "data_state": {
          "type": "null"
        }
      },
      "required": [
        "status",
        "compose_file_candidates",
        "effective_compose_files",
        "images",
        "build_sources",
        "data_state"
      ]
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "$ref": "#/$defs/git_parent"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/git_submodule"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "minItems": 0
        },
        "fingerprint_scope": {
          "const": "metadata_only"
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "root",
        "parent",
        "components",
        "issues",
        "fingerprint_scope",
        "fingerprint_sha256"
      ]
    },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/git_parent"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_fingerprint"
          },
          "minItems": 0
        },
        "source_archive": {
          "const": "not_captured"
        }
      },
      "required": [
        "version",
        "git",
        "sources",
        "source_archive"
      ]
    }
  }
}
