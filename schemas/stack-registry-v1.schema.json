{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deposium:schema:stack-registry:v1",
  "title": "Deposium stack registry v1",
  "description": "Planned stack contracts. Levels and assertions are future targets, not qualification evidence. Entrypoint and test paths are relative to the owning component; component paths are relative to stack_root. Global ID uniqueness and dependency references require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "deposium.stack-registry/v1"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "external_dependencies": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/external_dependency"
      }
    }
  },
  "required": [
    "schema_version",
    "components",
    "external_dependencies"
  ],
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[:\\\\\\r\\n])(?!.*//)(?!.*\\/$).+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "packs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "DOC",
              "FOLLOWUP",
              "PRESENTATION",
              "SOURCES",
              "EVIDENCE",
              "CLAIMS",
              "ROBUSTNESS",
              "CONTEXT",
              "EXTRACTION",
              "PRODUCT"
            ]
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "path",
        "owner",
        "role",
        "packs",
        "contracts",
        "notes"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[:\\\\\\r\\n])(?!.*//)(?!.*\\/$).+$"
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "http",
            "library",
            "bootstrap"
          ]
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        },
        "adapter_status": {
          "type": "string",
          "enum": [
            "planned",
            "available",
            "incompatible"
          ]
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tests": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[:\\\\\\r\\n])(?!.*//)(?!.*\\/$).+$"
          }
        }
      },
      "required": [
        "id",
        "entrypoint",
        "kind",
        "levels",
        "adapter_status",
        "assertions",
        "tests"
      ]
    },
    "external_dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "required_by"
      ]
    }
  }
}
