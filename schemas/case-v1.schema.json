{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deposium.case/v1",
  "description": "One case record, not the JSONL corpus. Runtime validation additionally checks identities, registry contracts, partition leakage, recursive annotation isolation and substantive typed assertions. JSON Schema cannot verify these cross-record invariants; typed alternatives are checked by Python.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "scenario_id",
    "translation_family",
    "document_ids",
    "split",
    "language",
    "pack",
    "contract_id",
    "input",
    "reference"
  ],
  "properties": {
    "schema_version": {
      "const": "deposium.case/v1"
    },
    "case_id": {
      "$ref": "#/$defs/text"
    },
    "scenario_id": {
      "$ref": "#/$defs/text"
    },
    "translation_family": {
      "$ref": "#/$defs/text"
    },
    "document_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "split": {
      "enum": [
        "train",
        "calibration",
        "test"
      ]
    },
    "language": {
      "enum": [
        "fr",
        "en"
      ]
    },
    "pack": {
      "enum": [
        "DOC",
        "FOLLOWUP",
        "PRESENTATION",
        "SOURCES",
        "EVIDENCE",
        "CLAIMS",
        "ROBUSTNESS",
        "CONTEXT",
        "EXTRACTION",
        "PRODUCT"
      ]
    },
    "contract_id": {
      "$ref": "#/$defs/text"
    },
    "input": {
      "type": "object",
      "minProperties": 1
    },
    "reference": {
      "$ref": "#/$defs/reference"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\x00-\\x1f]*$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertions",
        "abstention_allowed",
        "rationale"
      ],
      "properties": {
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "abstention_allowed": {
          "type": "boolean"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "op",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        },
        "op": {
          "enum": [
            "equals",
            "one_of",
            "set_equals"
          ]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "one_of"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "items": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "set_equals"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 0,
                "items": {}
              }
            }
          }
        }
      ]
    }
  }
}
